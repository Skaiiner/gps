{
  "name": "geopilot",
  "version": "1.0.0",
  "description": "Simulador de ubicaci\u00f3n GPS para iPhone por cable USB, sin jailbreak",
  "main": "./out/main/index.js",
  "author": {
    "name": "MDCL",
    "email": "76896366+Skaiiner@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "python:setup": "bash scripts/setup-python.sh",
    "python:setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-python.ps1",
    "python:bundle": "bash scripts/bundle-python.sh",
    "python:bundle:win": "powershell -ExecutionPolicy Bypass -File scripts/bundle-python.ps1",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --x64 && npm run sign:mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder -mw",
    "sign:mac": "bash scripts/sign-adhoc.sh",
    "install:mac": "bash scripts/install-local.sh"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "zustand": "^4.5.5"
  }
}
